msgstr "radnummer för associerad regel:"

#. TRANSLATORS: The characters that take the scanner from this state
#. to another state.
#: src/dfa.c:212
msgid "out-transitions:"
msgstr "utövergångar:"

#. TRANSLATORS: The characters that have no transition from this
#. state.
#: src/dfa.c:222
