#~ "\n"
#~ "Filer:\n"
#~ "  -o, --outfile=FIL       ange namn på utfil\n"
#~ "  -S, --skel=FIL          ange mallfil\n"
#~ "  -t, --stdout            skriv inläsare på standard ut istället för %s\n"
#~ "      --yyclass=NAMN      namn på C++-klass\n"
#~ "      --header-file=FIL   skapa en C-huvudfil förutom inläsaren\n"
