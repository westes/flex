# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1784
msgid ""
"Table Compression:\n"
"  -Ca, --align      trade off larger tables for better memory alignment\n"
"  -Ce, --ecs        construct equivalence classes\n"
"  -Cf               do not compress tables; use -f representation\n"
"  -CF               do not compress tables; use -F representation\n"
"  -Cm, --meta-ecs   construct meta-equivalence classes\n"
"  -Cr, --read       use read() instead of stdio for scanner input\n"
"  -f, --full        generate fast, large scanner. Same as -Cfr\n"
"  -F, --fast        use alternate table representation. Same as -CFr\n"
"  -Cem              default compression (same as --ecs --meta-ecs)\n"
msgstr ""
"Tabel-densigo:\n"
"  -Ca, --align      oferi pli grandajn tabelojn por pli bona memor-ĝustigo\n"
"  -Ce, --ecs        konstrui ekvivalent-klasojn\n"
"  -Cf               ne densigi tabelojn; uzi la reprezenton -f\n"
"  -CF               ne densigi tabelojn; uzi la reprezenton -F\n"
"  -Cm, --meta-ecs   konstrui meta-ekvivalent-klasojn\n"
"  -Cr, --read       uzi read() anstataŭ stdio por la enigo de la skanilo\n"
"  -f, --full        generi rapidan, grandan skanilon. Sama kiel -Cfr\n"
"  -F, --fast        uzi alian tabel-reprezenton. Sama kiel -CFr\n"
"  -Cem              implicita densigo (sama kiel --ecs --meta-ecs)\n"

# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1796
#, c-format
msgid ""
"Debugging:\n"
"  -d, --debug             enable debug mode in scanner\n"
"  -b, --backup            write backing-up information to %s\n"
"  -p, --perf-report       write performance report to stderr\n"
"  -s, --nodefault         suppress default rule to ECHO unmatched text\n"
"  -T, --trace             %s should run in trace mode\n"
"  -w, --nowarn            do not generate warnings\n"
"  -v, --verbose           write summary of scanner statistics to stdout\n"
"      --hex               use hexadecimal numbers instead of octal in debug "
"outputs\n"
msgstr ""
"Sencimigo:\n"
"  -d, --debug             ŝalti sencimigan reĝimon en la skanilo\n"
"  -b, --backup            skribi savkopian informon al %s\n"
"  -p, --perf-report       skribi rendiment-raporton al stderr\n"
"  -s, --nodefault         subpremi la implicitan regulon kiu ECHO-as nekorespondatan tekston\n"
"  -T, --trace             %s funkciu en spura reĝimo\n"
"  -w, --nowarn            ne generi avertojn\n"
"  -v, --verbose           skribi resumon de la skanil-statistiko al stdout\n"
"      --hex               uzi deksesumajn nombrojn anstataŭ oktumaj en sencimigaj eligoj\n"

# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1808
#, c-format
msgid ""
"Files:\n"
"  -o, --outfile=FILE      specify output filename\n"
"  -S, --skel=FILE         specify skeleton file\n"
"  -t, --stdout            write scanner on stdout instead of %s\n"
"      --yyclass=NAME      name of C++ class\n"
"      --header-file=FILE   create a C header file in addition to the "
"scanner\n"
"      --tables-file[=FILE] write tables to FILE\n"
"      --backup-file=FILE  write backing-up information to FILE\n"
msgstr ""
"Dosieroj:\n"
"  -o, --outfile=DOSIERO   specifi la nomon de la eliga dosiero\n"
"  -S, --skel=DOSIERO      specifi la skeletan dosieron\n"
"  -t, --stdout            skribi la skanilon al stdout anstataŭ %s\n"
"      --yyclass=NOMO      nomo de la klaso C++\n"
"      --header-file=DOSIERO   krei C-kapdosieron aldone al la skanilo\n"
"      --tables-file[=DOSIERO] skribi tabelojn al DOSIERO\n"
"      --backup-file=DOSIERO   skribi savkopian informon al DOSIERO\n"

# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1819
msgid ""
"Scanner behavior:\n"
"  -7, --7bit              generate 7-bit scanner\n"
"  -8, --8bit              generate 8-bit scanner\n"
"  -B, --batch             generate batch scanner (opposite of -I)\n"
"  -i, --case-insensitive  ignore case in patterns\n"
"  -l, --lex-compat        maximal compatibility with original lex\n"
"  -X, --posix-compat      maximal compatibility with POSIX lex\n"
"  -I, --interactive       generate interactive scanner (opposite of -B)\n"
"      --yylineno          track line count in yylineno\n"
msgstr ""
"Skanila konduto:\n"
"  -7, --7bit              generi 7-bitan skanilon\n"
"  -8, --8bit              generi 8-bitan skanilon\n"
"  -B, --batch             generi grup-skanilon (malo de -I)\n"
"  -i, --case-insensitive  ignori usklecon en modeloj\n"
"  -l, --lex-compat        maksimuma kongrueco kun la originala lex\n"
"  -X, --posix-compat      maksimuma kongrueco kun POSIX-lex\n"
"  -I, --interactive       generi interagan skanilon (malo de -B)\n"
"      --yylineno          kalkuli liniojn en yylineno\n"

# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1830
msgid ""
"Generated code:\n"
"  -+,  --c++               generate C++ scanner class\n"
"  -Dmacro[=defn]           #define macro defn  (default defn is '1')\n"
"  -e,  --emit=LANG         Specify target language\n"
"  -L,  --noline            suppress #line directives in scanner\n"
"  -P,  --prefix=STRING     use STRING as prefix instead of \"yy\"\n"
"  -R,  --reentrant         generate a reentrant scanner\n"
msgstr ""
"Generita kodo:\n"
"  -+,  --c++               generi C++-skanil-klason\n"
"  -Dmacro[=defn]           #define macro defn  (la implicita defn estas '1')\n"
"  -e,  --emit=LINGVO       specifi la celan lingvon\n"
"  -L,  --noline            subpremi #line-direktivojn en la skanilo\n"
"  -P,  --prefix=ĈENO       uzi ĈENON kiel prefikson anstataŭ \"yy\"\n"
"  -R,  --reentrant         generi re-enirantan skanilon\n"

# machine translation (Claude), not reviewed by a native speaker
