msgstr "непозната грешка при обработка на 1ви раздел"

#. TRANSLATORS: A "start condition" is a named state
#. of the scanner that turns groups of rules on and
#. off.
#: src/parse.y:195 src/parse.y:390
msgid "bad start condition list"
msgstr "неправилен списък на началните състояния"

#: src/parse.y:300
#, c-format
msgid "%s operator results in sub-optimal performance"
msgstr "операторът „%s“ води до забавяне"

#: src/parse.y:345
#, c-format
msgid "all start conditions already have %s rules"
msgstr "всички начални условия имат вече %s правила̀"

#: src/parse.y:354
msgid "syntax error: this is not a valid rule"
msgstr "СИНТАКТИЧНА ГРЕШКА: грешно правило"

#: src/parse.y:397
#, c-format
msgid "undeclared start condition %s"
msgstr "необявено начално условие: „%s“"

#: src/parse.y:405
#, c-format
msgid "<%s> specified twice"
msgstr "„%s“ е дефинирано двукратно"

#: src/parse.y:441 src/parse.y:501
#, c-format
msgid "trailing context made variable due to preceding '%s' action"
msgstr "последващият контекстът е направен променлив поради предшестващо действие „%s“"

#. TRANSLATORS: "Trailing context" is the part of a
#. rule that must match after the text of the rule,
#. written r/s or with a $ at the end of the rule. A
#. rule can have only one.
#: src/parse.y:478 src/parse.y:491 src/parse.y:561
msgid "trailing context used twice"
msgstr "двукратно ползване на последващ контекст"

#. TRANSLATORS: A "repeat range" is a pair of
#. numbers in braces after a pattern, such as
#. {2,5}, that sets how many times the
#. pattern may repeat.
#: src/parse.y:601 src/parse.y:612 src/parse.y:686 src/parse.y:697
msgid "invalid repeat range in braces: the first number must not be larger than the second, and the second must be at least 1"
msgstr "неправилен диапазон за повтаряне във „{}“: първото число не може да е по-малко от второто, а второто трябва да е поне 1"

#: src/parse.y:631 src/parse.y:649 src/parse.y:716 src/parse.y:734
msgid "the repeat count in braces must be at least 1"
msgstr "броят на повторенията във „{}“ трябва да е поне 1"

#: src/parse.y:857 src/parse.y:867
#, c-format
msgid "the character range [%c-%c] is ambiguous in a case-insensitive scanner"
msgstr "диапазонът знаци [%c-%c] не е еднозначен при лексичен анализатор, който не прави разлика между главни и малки знаци"

#: src/parse.y:872
msgid "negative range in character class"
msgstr "изключващ диапазон в клас от знаци"

#: src/parse.y:969
msgid "[:^lower:] is ambiguous in a case-insensitive scanner"
msgstr "диапазонът знаци [:^lower:] не е еднозначен при лексичен анализатор, който не прави разлика между главни и малки знаци"

#: src/parse.y:975
msgid "[:^upper:] is ambiguous in a case-insensitive scanner"
msgstr "диапазонът знаци [:^upper:] не е еднозначен при лексичен анализатор, който не прави разлика между главни и малки знаци"

#: src/parse.y:1019
#, c-format
msgid "multiple %s rules for start condition %s"
msgstr "множество правила̀ „%s“ за началното условие „%s“"

