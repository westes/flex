msgstr "Създаване на програми, които напасват шаблони по текст.\n"

#: src/main.c:1784
msgid ""
"Table Compression:\n"
"  -Ca, --align      trade off larger tables for better memory alignment\n"
"  -Ce, --ecs        construct equivalence classes\n"
"  -Cf               do not compress tables; use -f representation\n"
"  -CF               do not compress tables; use -F representation\n"
"  -Cm, --meta-ecs   construct meta-equivalence classes\n"
"  -Cr, --read       use read() instead of stdio for scanner input\n"
"  -f, --full        generate fast, large scanner. Same as -Cfr\n"
"  -F, --fast        use alternate table representation. Same as -CFr\n"
"  -Cem              default compression (same as --ecs --meta-ecs)\n"
msgstr ""
"Table Compression:\n"
"  -Ca, --align     по-точно подравняване в паметта, но по-големи таблици\n"
"  -Ce, --ecs       създаване на класове за еквивалентност\n"
"  -Cf              без компресиране на таблици, представяне както с „-f“\n"
"  -CF              без компресиране на таблици, представяне както с „-F“\n"
"  -Cm, --meta-ecs  създаване на класовете за мета-еквивалентност\n"
"  -Cr, --read      анализаторът да чете с „read()“ вместо от стандартния вход\n"
"  -f, --full       създаване на голям, но бърз анализатор (≡„-Cfr“)\n"
"  -F, --fast       алтернативно представяне на таблиците (≡„-CFr“)\n"
"  -Cem             стандартна компресия (≡„--ecs --meta-ecs“)\n"

#: src/main.c:1796
#, c-format
msgid ""
"Debugging:\n"
"  -d, --debug             enable debug mode in scanner\n"
"  -b, --backup            write backing-up information to %s\n"
"  -p, --perf-report       write performance report to stderr\n"
"  -s, --nodefault         suppress default rule to ECHO unmatched text\n"
"  -T, --trace             %s should run in trace mode\n"
"  -w, --nowarn            do not generate warnings\n"
"  -v, --verbose           write summary of scanner statistics to stdout\n"
"      --hex               use hexadecimal numbers instead of octal in debug outputs\n"
msgstr ""
"Изчистване на грешки:\n"
"  -d, --debug      включване на режима за изчистване на грешки в анализатора\n"
"  -b, --backup     извеждане на информацията за връщане назад в „%s“\n"
"  -p, --perf-report\n"
"                   извеждане на доклад за производителност на стандартната грешка\n"
"  -s, --nodefault  без стандартното правило за извеждане на ненапаснат текст\n"
"  -T, --trace      „%s“ да работи в режим на проследяване на изпълнението\n"
"  -w, --nowarn     без предупреждения\n"
"  -v, --verbose    извеждане на статистика на анализатора на стандартния изход\n"
"      --hex        шестнайсетични, а не осмични числа в изхода за изчистване на\n"
"                   грешки\n"

#: src/main.c:1808
#, c-format
msgid ""
"Files:\n"
"  -o, --outfile=FILE      specify output filename\n"
"  -S, --skel=FILE         specify skeleton file\n"
"  -t, --stdout            write scanner on stdout instead of %s\n"
"      --yyclass=NAME      name of C++ class\n"
"      --header-file=FILE   create a C header file in addition to the scanner\n"
"      --tables-file[=FILE] write tables to FILE\n"
"      --backup-file=FILE  write backing-up information to FILE\n"
msgstr ""
"Файлове:\n"
"  -o, --outfile=ФАЙЛ\n"
"                   задаване на изходния ФАЙЛ\n"
"  -S, --skel=ФАЙЛ  задаване на скелетния ФАЙЛ\n"
"  -t, --stdout     извеждане на анализатора на стандартния изход, а не в „%s“\n"
"      --yyclass=ИМЕ\n"
"                   ИМЕ на клас за C++\n"
"      --header-file=ФАЙЛ\n"
"                   създаване и на заглавен файл на C към анализатора\n"
"      --tables-file[=ФАЙЛ]\n"
"                   извеждане на таблиците във ФАЙЛа\n"
"      --backup-file=ФАЙЛ\n"
"                   извеждане на информацията за връщане назад във ФАЙЛа\n"

#: src/main.c:1819
msgid ""
"Scanner behavior:\n"
"  -7, --7bit              generate 7-bit scanner\n"
"  -8, --8bit              generate 8-bit scanner\n"
"  -B, --batch             generate batch scanner (opposite of -I)\n"
"  -i, --case-insensitive  ignore case in patterns\n"
"  -l, --lex-compat        maximal compatibility with original lex\n"
"  -X, --posix-compat      maximal compatibility with POSIX lex\n"
"  -I, --interactive       generate interactive scanner (opposite of -B)\n"
"      --yylineno          track line count in yylineno\n"
msgstr ""
"Поведение на анализатора:\n"
"  -7, --7bit       анализатор за 7-битов вход\n"
"  -8, --8bit       анализатор за 8-битов вход\n"
"  -B, --batch      пакетен анализатор (обратното на „-I“)\n"
"  -i, --case-insensitive\n"
"                   без разлика между главни и малки знаци\n"
"  -l, --lex-compat\n"
"                   максимална съвместимост с оригиналния „lex“\n"
"  -X, --posix-compat\n"
"                   максимална съвместимост с „lex“ по POSIX\n"
"  -I, --interactive\n"
"                   интерактивен анализатор (обратното на „-B“)\n"
"      --yylineno   следене на броя на редовете чрез „yylineno“\n"

#: src/main.c:1830
msgid ""
"Generated code:\n"
"  -+,  --c++               generate C++ scanner class\n"
"  -Dmacro[=defn]           #define macro defn  (default defn is '1')\n"
"  -e,  --emit=LANG         Specify target language\n"
"  -L,  --noline            suppress #line directives in scanner\n"
"  -P,  --prefix=STRING     use STRING as prefix instead of \"yy\"\n"
"  -R,  --reentrant         generate a reentrant scanner\n"
msgstr ""
"Генериран код:\n"
"  -+,  --c++       генериране на анализатор като клас на C++\n"
"  -DМАКРОС[=ДЕФИНИЦИЯ]\n"
"                   „#define МАКРОС ДЕФИНИЦИЯ“ (стандартно ДЕФИНИЦИЯта е „1“)\n"
"  -e,  --emit=ЕЗИК\n"
"                   указване на целеви ЕЗИК\n"
"  -L,  --noline    без директиви „#line“ в анализатора\n"
"  -P,  --prefix=НИЗ\n"
"                   използване на този НИЗ за префикс вместо обичайния „yy“\n"
"  -R,  --reentrant\n"
"                   анализатор с възможност за повторно извикване\n"

#: src/main.c:1837
msgid ""
"       --bison-bridge      scanner for Bison pure parser.\n"
"       --bison-locations   include yylloc support.\n"
"       --stdinit           initialize yyin/yyout to stdin/stdout\n"
"       --nounistd          do not include <unistd.h>\n"
"       --noFUNCTION        do not generate a particular FUNCTION\n"
msgstr ""
"       --bison-bridge\n"
"                   лексичен анализатор за синтактичен анализатор на „bison“\n"
"       --bison-locations\n"
"                   поддръжка на „yylloc“\n"
"       --stdinit   първоначалните стойности на „yyin“ и „yyout“ да са съответно\n"
"                   стандартният вход и изход\n"
"       --nounistd  без ползване на „<unistd.h>“\n"
"       --noФУНКЦИЯ\n"
"                   без създаването на определена ФУНКЦИЯ\n"

#: src/main.c:1844
#, c-format
msgid ""
"Miscellaneous:\n"
"  -c                      do-nothing POSIX option\n"
"  -n                      do-nothing POSIX option\n"
"  -?\n"
"  -h, --help              produce this help message\n"
"  -V, --version           report %s version\n"
msgstr ""
"Други:\n"
"  -c               опция по POSIX, която не прави нищо\n"
"  -n               опция по POSIX, която не прави нищо\n"
"  -?\n"
"  -h, --help       извеждане на това помощно съобщение\n"
"  -V, --version    извеждане на версията на „%s“\n"

