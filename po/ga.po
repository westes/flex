# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1784
msgid ""
"Table Compression:\n"
"  -Ca, --align      trade off larger tables for better memory alignment\n"
"  -Ce, --ecs        construct equivalence classes\n"
"  -Cf               do not compress tables; use -f representation\n"
"  -CF               do not compress tables; use -F representation\n"
"  -Cm, --meta-ecs   construct meta-equivalence classes\n"
"  -Cr, --read       use read() instead of stdio for scanner input\n"
"  -f, --full        generate fast, large scanner. Same as -Cfr\n"
"  -F, --fast        use alternate table representation. Same as -CFr\n"
"  -Cem              default compression (same as --ecs --meta-ecs)\n"
msgstr ""
"Comhbhrú táblaí:\n"
"  -Ca, --align      tabhair táblaí níos mó ar mhalairt ar chomhíniú cuimhne níos fearr\n"
"  -Ce, --ecs        tóg aicmí coibhéise\n"
"  -Cf               ná comhbhrúigh táblaí; úsáid léiriú -f\n"
"  -CF               ná comhbhrúigh táblaí; úsáid léiriú -F\n"
"  -Cm, --meta-ecs   tóg meiteaaicmí coibhéise\n"
"  -Cr, --read       úsáid read() in ionad stdio d'ionchur an scanóra\n"
"  -f, --full        gin scanóir tapa, mór. Mar an gcéanna le -Cfr\n"
"  -F, --fast        úsáid léiriú táblaí malartach. Mar an gcéanna le -CFr\n"
"  -Cem              comhbhrú réamhshocraithe (mar an gcéanna le --ecs --meta-ecs)\n"

# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1796
#, c-format
msgid ""
"Debugging:\n"
"  -d, --debug             enable debug mode in scanner\n"
"  -b, --backup            write backing-up information to %s\n"
"  -p, --perf-report       write performance report to stderr\n"
"  -s, --nodefault         suppress default rule to ECHO unmatched text\n"
"  -T, --trace             %s should run in trace mode\n"
"  -w, --nowarn            do not generate warnings\n"
"  -v, --verbose           write summary of scanner statistics to stdout\n"
"      --hex               use hexadecimal numbers instead of octal in debug "
"outputs\n"
msgstr ""
"Dífhabhtú:\n"
"  -d, --debug             cuir mód dífhabhtaithe ar siúl sa scanóir\n"
"  -b, --backup            scríobh eolas cúlaithe chuig %s\n"
"  -p, --perf-report       scríobh tuairisc feidhmíochta chuig stderr\n"
"  -s, --nodefault         cuir an riail réamhshocraithe ECHO ar neamhní do théacs gan meaitseáil\n"
"  -T, --trace             ba cheart do %s rith sa mhód rianaithe\n"
"  -w, --nowarn            ná gin rabhaidh\n"
"  -v, --verbose           scríobh achoimre ar staitisticí an scanóra chuig stdout\n"
"      --hex               úsáid uimhreacha heicsidheachúlacha in ionad ochtúla in aschuir dífhabhtaithe\n"

# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1808
#, c-format
msgid ""
"Files:\n"
"  -o, --outfile=FILE      specify output filename\n"
"  -S, --skel=FILE         specify skeleton file\n"
"  -t, --stdout            write scanner on stdout instead of %s\n"
"      --yyclass=NAME      name of C++ class\n"
"      --header-file=FILE   create a C header file in addition to the "
"scanner\n"
"      --tables-file[=FILE] write tables to FILE\n"
"      --backup-file=FILE  write backing-up information to FILE\n"
msgstr ""
"Comhaid:\n"
"  -o, --outfile=COMHAD    sonraigh ainm an chomhaid aschuir\n"
"  -S, --skel=COMHAD       sonraigh an creatchomhad\n"
"  -t, --stdout            scríobh an scanóir chuig stdout in ionad %s\n"
"      --yyclass=AINM      ainm an aicme C++\n"
"      --header-file=COMHAD   cruthaigh comhad ceanntásc C chomh maith leis an scanóir\n"
"      --tables-file[=COMHAD] scríobh táblaí chuig COMHAD\n"
"      --backup-file=COMHAD   scríobh eolas cúlaithe chuig COMHAD\n"

# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1819
msgid ""
"Scanner behavior:\n"
"  -7, --7bit              generate 7-bit scanner\n"
"  -8, --8bit              generate 8-bit scanner\n"
"  -B, --batch             generate batch scanner (opposite of -I)\n"
"  -i, --case-insensitive  ignore case in patterns\n"
"  -l, --lex-compat        maximal compatibility with original lex\n"
"  -X, --posix-compat      maximal compatibility with POSIX lex\n"
"  -I, --interactive       generate interactive scanner (opposite of -B)\n"
"      --yylineno          track line count in yylineno\n"
msgstr ""
"Iompar an scanóra:\n"
"  -7, --7bit              gin scanóir 7-giotán\n"
"  -8, --8bit              gin scanóir 8-giotán\n"
"  -B, --batch             gin scanóir baisceach (os coinne -I)\n"
"  -i, --case-insensitive  déan neamhaird de chás sna patrúin\n"
"  -l, --lex-compat        comhoiriúnacht uasta leis an lex bunaidh\n"
"  -X, --posix-compat      comhoiriúnacht uasta le lex POSIX\n"
"  -I, --interactive       gin scanóir idirghníomhach (os coinne -B)\n"
"      --yylineno          lean líon na línte in yylineno\n"

# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1830
msgid ""
"Generated code:\n"
"  -+,  --c++               generate C++ scanner class\n"
"  -Dmacro[=defn]           #define macro defn  (default defn is '1')\n"
"  -e,  --emit=LANG         Specify target language\n"
"  -L,  --noline            suppress #line directives in scanner\n"
"  -P,  --prefix=STRING     use STRING as prefix instead of \"yy\"\n"
"  -R,  --reentrant         generate a reentrant scanner\n"
msgstr ""
"Cód giniúnach:\n"
"  -+,  --c++               gin aicme scanóra C++\n"
"  -Dmacro[=defn]           #define macro defn  (is é '1' an defn réamhshocraithe)\n"
"  -e,  --emit=TEANGA       sonraigh an sprioctheanga\n"
"  -L,  --noline            ceilt treoracha #line sa scanóir\n"
"  -P,  --prefix=SRAINNG    úsáid SRAINNG mar réimír in ionad \"yy\"\n"
"  -R,  --reentrant         gin scanóir ath-iontrála\n"

# machine translation (Claude), not reviewed by a native speaker
