msgstr "Génère des programmes qui effectuent une reconnaissance de motifs sur du texte.\n"

#: src/main.c:1784
msgid ""
"Table Compression:\n"
"  -Ca, --align      trade off larger tables for better memory alignment\n"
"  -Ce, --ecs        construct equivalence classes\n"
"  -Cf               do not compress tables; use -f representation\n"
"  -CF               do not compress tables; use -F representation\n"
"  -Cm, --meta-ecs   construct meta-equivalence classes\n"
"  -Cr, --read       use read() instead of stdio for scanner input\n"
"  -f, --full        generate fast, large scanner. Same as -Cfr\n"
"  -F, --fast        use alternate table representation. Same as -CFr\n"
"  -Cem              default compression (same as --ecs --meta-ecs)\n"
msgstr ""
"Compression de table :\n"
"  -Ca, --align      accepter des tables plus volumineuses pour un meilleur alignement mémoire\n"
"  -Ce, --ecs        construire des classes d'équivalence\n"
"  -Cf               ne pas compresser les tables ; utiliser la représentation -f\n"
"  -CF               ne pas compresser les tables ; utiliser la représentation -F\n"
"  -Cm, --meta-ecs   construire des classes de méta-équivalence\n"
"  -Cr, --read       utiliser read() au lieu de stdio pour l'entrée de l'analyseur lexical\n"
"  -f, --full        générer un analyseur rapide mais volumineux. Identique à -Cfr\n"
"  -F, --fast        utiliser un représentation alternative des tables. Identique à -CFr\n"
"  -Cem              compression par défaut (identique à --ecs --meta-ecs)\n"

#: src/main.c:1796
#, c-format
msgid ""
"Debugging:\n"
"  -d, --debug             enable debug mode in scanner\n"
"  -b, --backup            write backing-up information to %s\n"
"  -p, --perf-report       write performance report to stderr\n"
"  -s, --nodefault         suppress default rule to ECHO unmatched text\n"
"  -T, --trace             %s should run in trace mode\n"
"  -w, --nowarn            do not generate warnings\n"
"  -v, --verbose           write summary of scanner statistics to stdout\n"
"      --hex               use hexadecimal numbers instead of octal in debug outputs\n"
msgstr ""
"Débogage :\n"
"  -d, --debug             active le mode débogage de l'analyseur lexical\n"
"  -b, --backup            écrire les informations de retour sur trace sur %s\n"
"  -p, --perf-report       écrire un rapport de performance sur stderr\n"
"  -s, --nodefault         supprimer la règle par défaut qui ECHO tout texte sans correspondance\n"
"  -T, --trace             exécuter %s en mode trace\n"
"  -w, --nowarn            ne pas générer d'avertissements\n"
"  -v, --verbose           écrire un résumé des performances de l'analyseur lexical sur stdout\n"
"      --hex               utiliser des nombres héxadécimaux et non octaux dans les sortie de débogage\n"

#: src/main.c:1808
#, c-format
msgid ""
"Files:\n"
"  -o, --outfile=FILE      specify output filename\n"
"  -S, --skel=FILE         specify skeleton file\n"
"  -t, --stdout            write scanner on stdout instead of %s\n"
"      --yyclass=NAME      name of C++ class\n"
"      --header-file=FILE   create a C header file in addition to the scanner\n"
"      --tables-file[=FILE] write tables to FILE\n"
"      --backup-file=FILE  write backing-up information to FILE\n"
msgstr ""
"Fichiers :\n"
"  -o, --outfile=FICHIER      indiquer le nom de FICHIER de la sortie\n"
"  -S, --skel=FICHIER         indiquer le nom de FICHIER du squelette\n"
"  -t, --stdout               écrire l'analyseur lexical sur stdout plustôt que sur %s\n"
"      --yyclass=NOM          indiquer le NOM de la classe C++\n"
"      --header-file=FICHIER   créér un FICHIER d'en-tête C en plus de l'analyseur lexical\n"
"      --tables-file[=FICHIER] écrire les tables dans le FICHIER\n"
"      --backup-file=FICHIER  écrire les informations de retour sur trace dans le FICHIER\n"

#: src/main.c:1819
msgid ""
"Scanner behavior:\n"
"  -7, --7bit              generate 7-bit scanner\n"
"  -8, --8bit              generate 8-bit scanner\n"
"  -B, --batch             generate batch scanner (opposite of -I)\n"
"  -i, --case-insensitive  ignore case in patterns\n"
"  -l, --lex-compat        maximal compatibility with original lex\n"
"  -X, --posix-compat      maximal compatibility with POSIX lex\n"
"  -I, --interactive       generate interactive scanner (opposite of -B)\n"
"      --yylineno          track line count in yylineno\n"
msgstr ""
"Comportement de l'analyseur lexical :\n"
"  -7, --7bit              générer un analyseur lexical de 7-bit\n"
"  -8, --8bit              générer un analyseur lexical de 8-bit\n"
"  -B, --batch             générer un analyseur lexical sans interaction (opposé de -I)\n"
"  -i, --case-insensitive  ignorer les cas dans les patrons\n"
"  -l, --lex-compat        compatibilité maximale avec le Lex original\n"
"  -X, --posix-compat      compatibilité maximale avec le Lex POSIX\n"
"  -I, --interactive       générer un analyseur lexical intéractif (opposé de -B)\n"
"      --yylineno          compter le numéro de ligne dans yylineno\n"

#: src/main.c:1830
msgid ""
"Generated code:\n"
"  -+,  --c++               generate C++ scanner class\n"
"  -Dmacro[=defn]           #define macro defn  (default defn is '1')\n"
"  -e,  --emit=LANG         Specify target language\n"
"  -L,  --noline            suppress #line directives in scanner\n"
"  -P,  --prefix=STRING     use STRING as prefix instead of \"yy\"\n"
"  -R,  --reentrant         generate a reentrant scanner\n"
msgstr ""
"Code généré :\n"
"  -+,  --c++               générer une classe d'analyseur lexical C++\n"
"  -Dmacro[=defn]           #define la macro « defn »  (le « defn » par défaut est « 1 »)\n"
"  -e,  --emit=LANGAGE      indiquer le LANGAGE cible\n"
"  -L,  --noline            supprimer les directives #line dans l'analyseur lexical\n"
"  -P,  --prefix=CHAÎNE     utiliser CHAÎNE comme préfixe plutôt que « yy »\n"
"  -R,  --reentrant         générer un analyseur lexical réentrant\n"

#: src/main.c:1837
msgid ""
"       --bison-bridge      scanner for Bison pure parser.\n"
"       --bison-locations   include yylloc support.\n"
"       --stdinit           initialize yyin/yyout to stdin/stdout\n"
"       --nounistd          do not include <unistd.h>\n"
"       --noFUNCTION        do not generate a particular FUNCTION\n"
msgstr ""
"       --bison-bridge      analyseur lexical pour un parseur Bison pur.\n"
"       --bison-locations   inclure la prise en charge de yylloc.\n"
"       --stdinit           initialiser yyin/yyout à stdin/stdout\n"
"       --nounistd          ne pas inclure <unistd.h>\n"
"       --noFONCTION        ne pas générer une certaine FONCTION en particulier\n"

#: src/main.c:1844
#, c-format
msgid ""
"Miscellaneous:\n"
"  -c                      do-nothing POSIX option\n"
"  -n                      do-nothing POSIX option\n"
"  -?\n"
"  -h, --help              produce this help message\n"
"  -V, --version           report %s version\n"
msgstr ""
"Divers :\n"
"  -c                      option héritée de POSIX et qui ne fait rien\n"
"  -n                      option héritée de POSIX et qui ne fait rien\n"
"  -?\n"
"  -h, --help              afficher ce message d'aider\n"
"  -V, --version           afficher la version %s\n"

