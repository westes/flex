#: src/main.c:1784
msgid ""
"Table Compression:\n"
"  -Ca, --align      trade off larger tables for better memory alignment\n"
"  -Ce, --ecs        construct equivalence classes\n"
"  -Cf               do not compress tables; use -f representation\n"
"  -CF               do not compress tables; use -F representation\n"
"  -Cm, --meta-ecs   construct meta-equivalence classes\n"
"  -Cr, --read       use read() instead of stdio for scanner input\n"
"  -f, --full        generate fast, large scanner. Same as -Cfr\n"
"  -F, --fast        use alternate table representation. Same as -CFr\n"
"  -Cem              default compression (same as --ecs --meta-ecs)\n"
msgstr ""
"Compressão da tabela:\n"
"  -Ca, --align      trocar tabelas maiores por um melhor alinhamento da memória\n"
"  -Ce, --ecs        construir classes de equivalência\n"
"  -Cf               não comprimir as tabelas; usar a representação -f\n"
"  -CF               não comprimir as tabelas; usar a representação -F\n"
"  -Cm, --meta-ecs   construir classes de meta-equivalência\n"
"  -Cr, --read       Usar read() em vez do stdio para a entrada do analisador\n"
"  -f, --full        gerar um analisador rápido e de grande capacidade. Igual a -Cfr\n"
"  -F, --fast        utilizar uma representação alternativa da tabela. Igual a -CFr\n"
"  -Cem              compressão predefinida (igual a --ecs --meta-ecs)\n"

#: src/main.c:1796
#, c-format
msgid ""
"Debugging:\n"
"  -d, --debug             enable debug mode in scanner\n"
"  -b, --backup            write backing-up information to %s\n"
"  -p, --perf-report       write performance report to stderr\n"
"  -s, --nodefault         suppress default rule to ECHO unmatched text\n"
"  -T, --trace             %s should run in trace mode\n"
"  -w, --nowarn            do not generate warnings\n"
"  -v, --verbose           write summary of scanner statistics to stdout\n"
"      --hex               use hexadecimal numbers instead of octal in debug outputs\n"
msgstr ""
"Depuração:\n"
"  -d, --debug             activar o modo de depuração no analisador\n"
"  -b, --backup            gravar as informações de salvaguarda em %s\n"
"  -p, --perf-report       elaborar um relatório de desempenho para stderr\n"
"  -s, --nodefault         suprimir a regra predefinida para ECHOar texto não correspondente\n"
"  -T, --trace             %s deve ser executado no modo de rastreio\n"
"  -w, --nowarn            não gerar avisos\n"
"  -v, --verbose           escrever um resumo das estatísticas do analisador na saída padrão\n"
"      --hex               utilizar números hexadecimais em vez de octais nas saídas de depuração\n"

#: src/main.c:1808
#, c-format
msgid ""
"Files:\n"
"  -o, --outfile=FILE      specify output filename\n"
"  -S, --skel=FILE         specify skeleton file\n"
"  -t, --stdout            write scanner on stdout instead of %s\n"
"      --yyclass=NAME      name of C++ class\n"
"      --header-file=FILE   create a C header file in addition to the scanner\n"
"      --tables-file[=FILE] write tables to FILE\n"
"      --backup-file=FILE  write backing-up information to FILE\n"
msgstr ""
"Ficheiros:\n"
"  -o, --outfile=FICH      especificar o nome do ficheiro de saída\n"
"  -S, --skel=FICH         especificar ficheiro de estrutura\n"
"  -t, --stdout            escrever os dados do analisador na saída padrão em vez de %s\n"
"      --yyclass=NOME      nome da classe C++\n"
"      --header-file=FICH   criar um ficheiro de cabeçalho C, além do analisador\n"
"      --tables-file[=FICH] escrever tabelas em FICH\n"
"      --backup-file=FICH  escrever informação de salvaguarda em FICH\n"

#: src/main.c:1819
msgid ""
"Scanner behavior:\n"
"  -7, --7bit              generate 7-bit scanner\n"
"  -8, --8bit              generate 8-bit scanner\n"
"  -B, --batch             generate batch scanner (opposite of -I)\n"
"  -i, --case-insensitive  ignore case in patterns\n"
"  -l, --lex-compat        maximal compatibility with original lex\n"
"  -X, --posix-compat      maximal compatibility with POSIX lex\n"
"  -I, --interactive       generate interactive scanner (opposite of -B)\n"
"      --yylineno          track line count in yylineno\n"
msgstr ""
"Comportamento do analisador:\n"
"  -7, --7bit              gerar analisador de 7 bits\n"
"  -8, --8bit              gerar analisador de 8 bits\n"
"  -B, --batch             gerar analisador em lote (o oposto de -I)\n"
"  -i, --case-insensitive  ignorar maiúsculas e minúsculas nos padrões\n"
"  -l, --lex-compat        máxima compatibilidade com o lex original\n"
"  -X, --posix-compat      máxima compatibilidade com o POSIX lex\n"
"  -I, --interactive       criar analisador interactivo (o oposto de -B)\n"
"      --yylineno          rastrear total de linhas em yylineno\n"

#: src/main.c:1830
msgid ""
"Generated code:\n"
"  -+,  --c++               generate C++ scanner class\n"
"  -Dmacro[=defn]           #define macro defn  (default defn is '1')\n"
"  -e,  --emit=LANG         Specify target language\n"
"  -L,  --noline            suppress #line directives in scanner\n"
"  -P,  --prefix=STRING     use STRING as prefix instead of \"yy\"\n"
"  -R,  --reentrant         generate a reentrant scanner\n"
msgstr ""
"Código gerado:\n"
"  -+,  --c++               gerar uma classe de analisador em C++\n"
"  -Dmacro[=defn]           #define macro defn  (predefinição de defn é \"1\")\n"
"  -e,  --emit=LANG         Especificar a linguagem-destino\n"
"  -L,  --noline            suprimir directivas #line no analisador\n"
"  -P,  --prefix=CADEIA     utilizar CADEIA como prefixo em vez de \"yy\"\n"
"  -R,  --reentrant         gerar um analisador reentrante\n"

#: src/main.c:1837
msgid ""
"       --bison-bridge      scanner for Bison pure parser.\n"
"       --bison-locations   include yylloc support.\n"
"       --stdinit           initialize yyin/yyout to stdin/stdout\n"
"       --nounistd          do not include <unistd.h>\n"
"       --noFUNCTION        do not generate a particular FUNCTION\n"
msgstr ""
"       --bison-bridge      analisador para «Bison pure».\n"
"       --bison-locations   incluir suporte a yylloc.\n"
"       --stdinit           inicializar yyin/yyout em stdin/stdout\n"
"       --nounistd          não incluir <unistd.h>\n"
"       --noFUNÇÃO        não gerar uma FUNÇÃO particular\n"

#: src/main.c:1844
#, c-format
msgid ""
"Miscellaneous:\n"
"  -c                      do-nothing POSIX option\n"
"  -n                      do-nothing POSIX option\n"
"  -?\n"
"  -h, --help              produce this help message\n"
