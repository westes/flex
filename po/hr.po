# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1784
msgid ""
"Table Compression:\n"
"  -Ca, --align      trade off larger tables for better memory alignment\n"
"  -Ce, --ecs        construct equivalence classes\n"
"  -Cf               do not compress tables; use -f representation\n"
"  -CF               do not compress tables; use -F representation\n"
"  -Cm, --meta-ecs   construct meta-equivalence classes\n"
"  -Cr, --read       use read() instead of stdio for scanner input\n"
"  -f, --full        generate fast, large scanner. Same as -Cfr\n"
"  -F, --fast        use alternate table representation. Same as -CFr\n"
"  -Cem              default compression (same as --ecs --meta-ecs)\n"
msgstr ""
"Sažimanje tablica:\n"
"  -Ca, --align      žrtvuj veće tablice za bolje poravnanje memorije\n"
"  -Ce, --ecs        konstruiraj klase ekvivalencije\n"
"  -Cf               ne sažimaj tablice; koristi -f prikaz\n"
"  -CF               ne sažimaj tablice; koristi -F prikaz\n"
"  -Cm, --meta-ecs   konstruiraj meta-klase ekvivalencije\n"
"  -Cr, --read       koristi read() umjesto stdio za ulaz skenera\n"
"  -f, --full        stvori brzi, veliki skener. Isto kao -Cfr\n"
"  -F, --fast        koristi alternativni prikaz tablica. Isto kao -CFr\n"
"  -Cem              zadano sažimanje (isto kao --ecs --meta-ecs)\n"

# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1796
#, c-format
msgid ""
"Debugging:\n"
"  -d, --debug             enable debug mode in scanner\n"
"  -b, --backup            write backing-up information to %s\n"
"  -p, --perf-report       write performance report to stderr\n"
"  -s, --nodefault         suppress default rule to ECHO unmatched text\n"
"  -T, --trace             %s should run in trace mode\n"
"  -w, --nowarn            do not generate warnings\n"
"  -v, --verbose           write summary of scanner statistics to stdout\n"
"      --hex               use hexadecimal numbers instead of octal in debug "
"outputs\n"
msgstr ""
"Otklanjanje grešaka:\n"
"  -d, --debug             uključi način otklanjanja grešaka u skeneru\n"
"  -b, --backup            zapiši informacije o vraćanju u %s\n"
"  -p, --perf-report       zapiši izvješće o performansama na stderr\n"
"  -s, --nodefault         potisni zadano pravilo koje radi ECHO nepodudarnog teksta\n"
"  -T, --trace             %s treba raditi u načinu praćenja\n"
"  -w, --nowarn            ne stvaraj upozorenja\n"
"  -v, --verbose           zapiši sažetak statistike skenera na stdout\n"
"      --hex               koristi heksadecimalne umjesto oktalnih brojeva u izlazu otklanjanja grešaka\n"

# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1808
#, c-format
msgid ""
"Files:\n"
"  -o, --outfile=FILE      specify output filename\n"
"  -S, --skel=FILE         specify skeleton file\n"
"  -t, --stdout            write scanner on stdout instead of %s\n"
"      --yyclass=NAME      name of C++ class\n"
"      --header-file=FILE   create a C header file in addition to the "
"scanner\n"
"      --tables-file[=FILE] write tables to FILE\n"
"      --backup-file=FILE  write backing-up information to FILE\n"
msgstr ""
"Datoteke:\n"
"  -o, --outfile=DATOTEKA  odredi ime izlazne datoteke\n"
"  -S, --skel=DATOTEKA     odredi datoteku predloška\n"
"  -t, --stdout            zapiši skener na stdout umjesto %s\n"
"      --yyclass=IME       ime C++ klase\n"
"      --header-file=DATOTEKA   stvori C datoteku zaglavlja uz skener\n"
"      --tables-file[=DATOTEKA] zapiši tablice u DATOTEKU\n"
"      --backup-file=DATOTEKA   zapiši informacije o vraćanju u DATOTEKU\n"

# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1819
msgid ""
"Scanner behavior:\n"
"  -7, --7bit              generate 7-bit scanner\n"
"  -8, --8bit              generate 8-bit scanner\n"
"  -B, --batch             generate batch scanner (opposite of -I)\n"
"  -i, --case-insensitive  ignore case in patterns\n"
"  -l, --lex-compat        maximal compatibility with original lex\n"
"  -X, --posix-compat      maximal compatibility with POSIX lex\n"
"  -I, --interactive       generate interactive scanner (opposite of -B)\n"
"      --yylineno          track line count in yylineno\n"
msgstr ""
"Ponašanje skenera:\n"
"  -7, --7bit              stvori 7-bitni skener\n"
"  -8, --8bit              stvori 8-bitni skener\n"
"  -B, --batch             stvori skener za skupnu obradu (suprotno od -I)\n"
"  -i, --case-insensitive  zanemari veličinu slova u uzorcima\n"
"  -l, --lex-compat        najveća kompatibilnost s izvornim lexom\n"
"  -X, --posix-compat      najveća kompatibilnost s POSIX lexom\n"
"  -I, --interactive       stvori interaktivni skener (suprotno od -B)\n"
"      --yylineno          prati broj redaka u yylineno\n"

# machine translation (Claude), not reviewed by a native speaker
#: src/main.c:1830
msgid ""
"Generated code:\n"
"  -+,  --c++               generate C++ scanner class\n"
"  -Dmacro[=defn]           #define macro defn  (default defn is '1')\n"
"  -e,  --emit=LANG         Specify target language\n"
"  -L,  --noline            suppress #line directives in scanner\n"
"  -P,  --prefix=STRING     use STRING as prefix instead of \"yy\"\n"
"  -R,  --reentrant         generate a reentrant scanner\n"
msgstr ""
"Generirani kôd:\n"
"  -+,  --c++               stvori C++ klasu skenera\n"
"  -Dmacro[=defn]           #define macro defn  (zadani defn je „1”)\n"
"  -e,  --emit=JEZIK        odredi ciljni jezik\n"
"  -L,  --noline            potisni #line direktive u skeneru\n"
"  -P,  --prefix=NIZ        koristi NIZ kao prefiks umjesto „yy”\n"
"  -R,  --reentrant         stvori reentrantni skener\n"

