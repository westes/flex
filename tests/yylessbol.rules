 /*
  * Test that yyless() resets the beginning-of-line state.  What should
  * happen is:
  * 1. "ab\ncd" is matched by the first rule.
  * 2. yyless(3) keeps "ab\n" and pushes back "cd".
  * 3. The scanner is now at the start of a line, so "cd" is matched by the
  *    second rule, which is anchored.  If the state is not reset, the third
  *    rule matches it instead and the test fails.
  */

%option nounput noyywrap noyylineno warn nodefault noinput
%%
ab\ncd	{M4_TEST_DO(yyless(3))}
^cd	;
cd	{M4_TEST_FAILMESSAGE}
.|\n	;

###
ab
cd
