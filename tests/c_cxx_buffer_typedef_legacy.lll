%{
/* Test that a C scanner compiled as C++ still honors a program's own
   YY_BUFFER_STATE declaration, guarded by YY_TYPEDEF_YY_BUFFER_STATE.
   Compiled as C++, the scanner's struct is still yy_buffer_state, so a
   program that names that struct, as IGC does, links. */
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include "config.h"
%}

%top{
#ifndef YY_TYPEDEF_YY_BUFFER_STATE
#define YY_TYPEDEF_YY_BUFFER_STATE
typedef struct yy_buffer_state *YY_BUFFER_STATE;
#endif
}

%option 8bit prefix="test"
%option nomain nodefault noyywrap noinput nounput
%option warn

%%

.|\n   { }

%%

int main(void);

int
main (void)
{
    YY_BUFFER_STATE old_name;
    yybuffer new_name;
    struct yy_buffer_state copy;

    old_name = new_name = test_scan_string("text");
    copy = *new_name;
    (void) copy;
    testlex();
    test_delete_buffer(old_name);

    printf("TEST RETURNING OK.\n");
    return 0;
}
