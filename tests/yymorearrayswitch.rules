 /*
  * Test yyless below the yymore() text with %array when the scanner
  * switches to another buffer in between.  The saved text is not in the
  * new buffer, so yymore() ends at the switch, as it does with %pointer.
  * What should happen is:
  * 1. "aaaa" is saved by yymore() and the scanner switches to a buffer
  *    that holds "bbbbbb".
  * 2. "bbbbbb" is matched with token length 6, not 10.  yyless(2) keeps
  *    "bb".
  * 3. The other four "b" characters go back to the input and are matched
  *    one at a time.
  */

%array
%option nounput noyywrap yylineno warn nodefault noinput
%{
#include <string.h>
static int singles;
%}
%%
a{4}	{M4_TEST_DO(yymore()) M4_TEST_DO(M4_TEST_SWITCH_STRING("bbbbbb"))}
b{6}	{if (yyleng != 6 || strcmp(yytext, "bbbbbb") != 0) {fprintf(stderr,"ASSERT FAILED: yymore() across a switch.\n"); exit(1);} M4_TEST_DO(yyless(2)) if (yyleng != 2 || strcmp(yytext, "bb") != 0) {fprintf(stderr,"ASSERT FAILED: yyless(2).\n"); exit(1);}}
b	{++singles; if (singles > 4) {M4_TEST_FAILMESSAGE}}
\n	;
.	{M4_TEST_FAILMESSAGE}
###
aaaa
