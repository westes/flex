 /*
  * Test that yyless(0) restores the beginning-of-line state.  What should
  * happen is:
  * 1. "q" at the start of the input is matched by the anchored rule in the
  *    initial state, which switches to the other state.
  * 2. yyless(0) gives the "q" back.  The scanner is then back where it was
  *    before the match, which was the start of a line.
  * 3. The anchored rule in the other state matches the "q".  If the state is
  *    left set from the end of the given-back text, the unanchored rule
  *    matches it instead and the test fails.
  */

%{
/* The c99 back end has a function in place of the BEGIN macro. */
#ifndef BEGIN
#define BEGIN(s) yybegin((s), yyscanner)
#endif
%}

%option nounput noyywrap noyylineno warn nodefault noinput
%x OTHER
%%
<INITIAL>^q	{M4_TEST_DO(BEGIN(OTHER); yyless(0))}
<OTHER>^q	;
<OTHER>q	{M4_TEST_FAILMESSAGE}
<*>.|\n	;

###
q
