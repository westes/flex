#!/bin/sh

# Test that a C++ scanner flex generates stops with a clear message when
# the FlexLexer.h it finds comes from another version of flex, as a copy
# kept with a project can, and that it compiles with the FlexLexer.h
# from this flex.  An old copy has no YY_FLEXLEXER_MAJOR_VERSION.

FLEX=$1
CXX_ARG=$2
SRCDIR=$3
case $FLEX in
    /*) ;;
    *) FLEX=$(pwd)/$FLEX ;;
esac

if [ -z "$CXX_ARG" ]; then
    echo "no C++ compiler" >&2
    exit 77
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/hdr.XXXXXX") || exit 99
trap 'rm -rf "$work"' EXIT HUP INT QUIT TERM

probe=$work/probe.cc
printf '#include <cstdio>\nint main() { return 0; }\n' > "$probe"
if ! $CXX_ARG -c -o /dev/null "$probe" >/dev/null 2>&1; then
    echo "note: skipping $CXX_ARG (cannot compile a trivial file)" >&2
    exit 77
fi

cat > "$work/hdr.l" <<'EOT'
%option c++ noyywrap
%%
x		;
%%
EOT

if ! "$FLEX" -o "$work/hdr.cc" "$work/hdr.l" 2>"$work/flex.txt"; then
    echo "FAIL: flex failed: $(cat "$work/flex.txt")" >&2
    exit 1
fi

failures=0

# The header from this flex.
if ! $CXX_ARG -c -o /dev/null -I"$SRCDIR" "$work/hdr.cc" > "$work/cc.txt" 2>&1; then
    echo "FAIL: the scanner did not compile with this flex's FlexLexer.h" >&2
    sed 's/^/    /' "$work/cc.txt" >&2
    failures=$((failures + 1))
fi

# A header without a version, and one with a different version, standing
# in for copies from other flex releases.
mkdir "$work/none" "$work/other"
grep -v 'YY_FLEXLEXER_' "$SRCDIR/FlexLexer.h" > "$work/none/FlexLexer.h"
sed 's/^\(#define YY_FLEXLEXER_SUBMINOR_VERSION\) .*/\1 99/' "$SRCDIR/FlexLexer.h" \
    > "$work/other/FlexLexer.h"
for d in none other; do
    if $CXX_ARG -c -o /dev/null -I"$work/$d" "$work/hdr.cc" > "$work/cc.txt" 2>&1; then
        echo "FAIL: the scanner compiled with a FlexLexer.h of the wrong version ($d)" >&2
        failures=$((failures + 1))
    elif ! grep -q 'FlexLexer.h version mismatch' "$work/cc.txt"; then
        echo "FAIL: the compiler did not give the message about FlexLexer.h ($d)" >&2
        sed 's/^/    /' "$work/cc.txt" >&2
        failures=$((failures + 1))
    fi
done

if [ "$failures" -ne 0 ]; then
    exit 1
fi
echo "FlexLexer.h version check passed"
